<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgroClimaMaui.ViewModels"
             x:Class="AgroClimaMaui.Views.NutricaoPage"
             Title="Nutrição USDA"
             BackgroundColor="#F5F5F5">
    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame BackgroundColor="#E65100" CornerRadius="10" Padding="15">
                <VerticalStackLayout>
                    <Label Text="🥗 Informações Nutricionais" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="USDA FoodData Central" FontSize="12" TextColor="#FFCC80" />
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <VerticalStackLayout>
                    <Label Text="Produto Analisado" FontAttributes="Bold" TextColor="#E65100" />
                    <Label Text="{Binding AlimentoUsda.Descricao}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding AlimentoUsda.Categoria}" FontSize="14" TextColor="#666" />
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📋 Ficha Técnica (por 100g)" FontAttributes="Bold" TextColor="#E65100" FontSize="16" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Calorias:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AlimentoUsda.FichaTecnica.Calorias, StringFormat='{0:F0} kcal'}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Proteína:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AlimentoUsda.FichaTecnica.Proteina, StringFormat='{0:F1} g'}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Gordura:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding AlimentoUsda.FichaTecnica.Gordura, StringFormat='{0:F1} g'}" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Carboidrato:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding AlimentoUsda.FichaTecnica.Carboidrato, StringFormat='{0:F1} g'}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🧪 Nutrientes Detalhados" FontAttributes="Bold" TextColor="#E65100" FontSize="16" />
                    <CollectionView ItemsSource="{Binding AlimentoUsda.Nutrientes}" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="5" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Nome}" FontSize="14" />
                                    <Label Grid.Column="1" Text="{Binding Quantidade, StringFormat='{0:F1}'}" FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Column="2" Text="{Binding Unidade}" FontSize="12" TextColor="#666" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
